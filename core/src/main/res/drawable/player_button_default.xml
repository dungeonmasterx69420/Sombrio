<?xml version="1.0" encoding="utf-8"?>
<!-- The player's play button: System S's default button, a pane with an ink edge and the outer
     ring, inverted while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <stroke android:width="2dp" android:color="@color/system_s_ink_dark" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape>
                    <solid android:color="@color/system_s_ink_dark" />
                    <stroke android:width="1dp" android:color="@color/system_s_ink_dark" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <stroke android:width="2dp" android:color="@color/system_s_ink_dark" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape>
                    <solid android:color="@color/system_s_pane_dark" />
                    <stroke android:width="1dp" android:color="@color/system_s_ink_dark" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
