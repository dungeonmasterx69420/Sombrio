<?xml version="1.0" encoding="utf-8"?>
<!-- The unlock button of the locked player: a System S button on the video -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/system_s_ink_dark" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#B30E0E0E" />
            <stroke android:width="1dp" android:color="@color/system_s_ink_dark" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
